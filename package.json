{
  "name": "iluvmd",
  "version": "0.1.0",
  "description": "Convert documents to Markdown and Markdown to documents, on your own machine. No uploads, no network calls.",
  "license": "MIT",
  "homepage": "https://iluvmd.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RBJGlobal/ilovemd-cli.git"
  },
  "bin": {
    "iluvmd": "bin/iluvmd.js"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "lib/",
    "vendor/",
    "licenses/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "npm-shrinkwrap.json",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "sync": "node scripts/sync-from-site.js"
  },
  "dependencies": {
    "dompurify": "3.2.7",
    "jsdom": "30.1.3",
    "mammoth": "1.11.0"
  }
}
