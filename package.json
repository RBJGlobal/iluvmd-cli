{
  "name": "iluvmd",
  "version": "0.1.0",
  "description": "Convert PDF, Word, HTML and text to Markdown, and Markdown to Word, PDF and HTML, from the command line. Runs on your machine: no uploads, no network calls.",
  "license": "MIT",
  "homepage": "https://iluvmd.com/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RBJGlobal/iluvmd-cli.git"
  },
  "bin": {
    "iluvmd": "bin/iluvmd.js"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "lib/",
    "vendor/",
    "licenses/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "npm-shrinkwrap.json",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "sync": "node scripts/sync-from-site.js"
  },
  "dependencies": {
    "dompurify": "3.2.7",
    "jsdom": "30.1.3",
    "mammoth": "1.11.0"
  },
  "keywords": [
    "markdown",
    "converter",
    "cli",
    "pdf-to-markdown",
    "docx-to-markdown",
    "html-to-markdown",
    "markdown-to-pdf",
    "markdown-to-docx",
    "markdown-to-html",
    "pdf",
    "docx",
    "word",
    "html",
    "llm",
    "rag",
    "document-conversion",
    "offline",
    "privacy"
  ],
  "bugs": {
    "url": "https://github.com/RBJGlobal/iluvmd-cli/issues"
  }
}
